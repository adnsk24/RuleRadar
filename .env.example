# RuleRadar AI - Environment Configuration Example

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Database URL (Default: local SQLite database)
DATABASE_URL=sqlite:///data/ruleradar.db

# Processing Limits
MAX_FILE_SIZE_MB=25
MAX_PDF_PAGES=150

# NLP and Model Configurations
USE_GPU=False
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
OFFLINE_MODE=False

# Risk and Importance Thresholds
RISK_THRESHOLD_HIGH=0.70
RISK_THRESHOLD_MEDIUM=0.40
IMPORTANCE_THRESHOLD_HIGH=7.0
IMPORTANCE_THRESHOLD_MEDIUM=4.0

# Comparison Thresholds
COMPARISON_SIMILARITY_THRESHOLD=0.75
COMPARISON_IDENTICAL_THRESHOLD=0.98
